# =====================================================================
# cluster.env — single source of truth for the 3-laptop cluster.
# Edit ONLY the placeholders below, then copy the whole project folder
# to all three laptops (same file everywhere).
# =====================================================================

# --- LAN IP addresses (use fixed IPs / DHCP reservations, see README §2)
MASTER_IP="192.168.100.47"        # e.g. 192.168.1.10  (Aiken's laptop, Node 1)
WORKER1_IP="192.168.100.67"      # e.g. 192.168.1.11  (Node 2)
WORKER2_IP="192.168.100.15"      # e.g. 192.168.1.12  (Node 3)

# --- Linux login name on each laptop (they may differ between laptops)
MASTER_USER="aykkenn"
WORKER1_USER="zhuldyzay"
WORKER2_USER="inkar"

# --- Fixed hostnames (do not change: every config file uses them)
ALL_NODES=(master worker1 worker2)

# --- Install locations. 03_prepare_node.sh creates these as symlinks to
#     your real install dirs, so the path is IDENTICAL on all nodes
#     (start-dfs.sh / start-workers.sh run the master's paths remotely).
HADOOP_HOME="/opt/hadoop"
SPARK_HOME="/opt/spark"

# --- Optional: absolute path (on master) of the Iceberg Spark runtime jar.
#     Leave empty to auto-detect it in $SPARK_HOME/jars.
ICEBERG_JAR=""

# --- Local disk layout (Linux filesystem, on every node)
LOCAL_ROOT="/bigdata"
STAGING_DIR="/bigdata/staging/ecommerce"
EVIDENCE_DIR="/bigdata/evidence/phase1"

# --- HDFS layout (paths inside HDFS, not on local disk)
HDFS_URI="hdfs://master:9000"
HDFS_RAW_DIR="/data/raw/ecommerce"
HDFS_META_DIR="/data/meta/ingest"
HDFS_WAREHOUSE="/warehouse/iceberg"
HDFS_SPARK_LOGS="/spark-logs"
BLOCK_SIZE=134217728           # 128 MB
REPLICATION=3

# --- Dataset
DATA_FILES=("2019-Oct.csv" "2019-Nov.csv")
EXPECTED_HEADER="event_time,event_type,product_id,category_id,category_code,brand,price,user_id,user_session"
